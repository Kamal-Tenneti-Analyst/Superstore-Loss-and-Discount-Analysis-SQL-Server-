-- 01_table_creation.sql
-- Purpose: create the Superstore database (run once) and the SuperstoreDB table

CREATE DATABASE Superstore;
GO

USE Superstore;
GO

CREATE TABLE SuperstoreDB (
    [Row ID]        INT            NOT NULL PRIMARY KEY,
    [Order ID]      VARCHAR(20)    NOT NULL,
    [Order Date]    VARCHAR(12)    NOT NULL,   -- text for now (two date formats in the file)
    [Ship Date]     VARCHAR(12)    NOT NULL,   -- text for now (two date formats in the file)
    [Ship Mode]     VARCHAR(20)    NOT NULL,
    [Customer ID]   VARCHAR(20)    NOT NULL,
    [Customer Name] VARCHAR(50)    NOT NULL,
    Segment         VARCHAR(20)    NOT NULL,
    Country         VARCHAR(30)    NOT NULL,
    City            VARCHAR(50)    NOT NULL,
    State           VARCHAR(50)    NOT NULL,
    [Postal Code]   VARCHAR(10)    NOT NULL,   -- identifier, not a number
    Region          VARCHAR(10)    NOT NULL,
    [Product ID]    VARCHAR(20)    NOT NULL,
    Category        VARCHAR(20)    NOT NULL,
    [Sub-Category]  VARCHAR(20)    NOT NULL,
    [Product Name]  VARCHAR(200)   NOT NULL,
    Sales           DECIMAL(12,4)  NOT NULL,
    Quantity        INT            NOT NULL,
    Discount        DECIMAL(4,2)   NOT NULL,
    Profit          DECIMAL(12,4)  NOT NULL
);
GO




-- 02_bulk_insert.sql
-- Purpose: load the Superstore CSV into the SuperstoreDB table
-- Before running: change the file path below to where you saved the CSV

USE Superstore;
GO

BULK INSERT SuperstoreDB
FROM 'C:\Data\Sample - Superstore.csv'   -- <-- change to your CSV location
WITH (
    FORMAT     = 'CSV',
    FIRSTROW   = 2,        -- skip the header row
    FIELDQUOTE = '"',      -- some product names contain commas inside quotes
    CODEPAGE   = '1252'    -- the file is not UTF-8
);
GO



