-- 04_audit_table.sql
-- Purpose: audit the descriptive columns before analysing

USE Superstore;
GO

-- What are the categories?
SELECT DISTINCT Category FROM SuperstoreDB;

-- Which sub-category belongs to which category?
SELECT DISTINCT Category, [Sub-Category]
FROM SuperstoreDB
ORDER BY Category ASC, [Sub-Category] DESC;

-- Other descriptive columns
SELECT DISTINCT Region      FROM SuperstoreDB;
SELECT DISTINCT [Ship Mode] FROM SuperstoreDB;
SELECT DISTINCT Segment     FROM SuperstoreDB;
SELECT DISTINCT State       FROM SuperstoreDB ORDER BY State;

-- Which discount levels exist?
SELECT DISTINCT Discount, Category
FROM SuperstoreDB
ORDER BY Discount;



-- 05_loss_analysis.sql
-- Purpose: find the biggest losses and the worst margins

USE Superstore;
GO

-- The 10 biggest losses
SELECT TOP 10 [Row ID], [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
ORDER BY Profit ASC;

-- The 10 worst profit margins (alias, calculation, execution order)
SELECT TOP 10 [Row ID], [Sub-Category], Sales, Discount, Profit,
       Profit / Sales AS ProfitMargin
FROM SuperstoreDB
ORDER BY ProfitMargin ASC, [Row ID];

-- Which sub-categories appear among the really big losses?
SELECT DISTINCT [Sub-Category]
FROM SuperstoreDB
WHERE Profit < -500;

-- Losses in the Central region
SELECT TOP 10 [Row ID], City, State, [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
WHERE Profit < 0 AND Region = 'Central'
ORDER BY Profit ASC;

-- Losses in Texas
SELECT TOP 10 [Row ID], City, [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
WHERE Profit < 0 AND State = 'Texas'
ORDER BY Profit ASC;




-- 06_discount_hypothesis.sql
-- Purpose: test whether heavy discounting is linked to losses

USE Superstore;
GO

-- Loss-making rows with a heavy discount (30% or more)
SELECT [Row ID], [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
WHERE Profit < 0 AND Discount >= 0.3
ORDER BY Profit ASC;

-- Loss-making rows with no discount at all
SELECT [Row ID], [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
WHERE Profit < 0 AND Discount = 0;

-- Profitable rows with a heavy discount (do any survive?)
SELECT [Row ID], [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
WHERE Profit > 0 AND Discount >= 0.3
ORDER BY Profit DESC;

-- Loss-making rows with a light discount (under 30%, but not zero)
SELECT [Row ID], [Sub-Category], Sales, Discount, Profit
FROM SuperstoreDB
WHERE Profit < 0 AND Discount > 0 AND Discount < 0.3
ORDER BY Profit ASC;

-- Which discount levels are common among losses?
SELECT DISTINCT Discount
FROM SuperstoreDB
WHERE Profit < 0
ORDER BY Discount;




